{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-spec-v2",
  "title": "WorkflowSpec",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "nodes", "edges"],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "2.0"]},
    "manifestVersion": {"type": ["string", "null"]},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "viewport": {"type": ["object", "null"]},
    "metadata": {"type": ["object", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "position": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "additionalProperties": false},
        "data": {
          "type": "object",
          "required": ["label", "description", "kind", "status", "config"],
          "properties": {
            "label": {"type": "string"}, "description": {"type": "string"}, "kind": {"type": "string"},
            "inputType": {"type": ["string", "null"]}, "outputType": {"type": ["string", "null"]},
            "status": {"type": "string"}, "config": {"type": "object"}, "fieldSchema": {"type": "array"},
            "ports": {"type": ["object", "null"]}, "moduleId": {"type": ["string", "null"]},
            "moduleVersion": {"type": ["string", "null"]}, "configOverrides": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"},
        "sourceHandle": {"type": ["string", "null"]}, "targetHandle": {"type": ["string", "null"]},
        "type": {"type": "string"}, "data": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
