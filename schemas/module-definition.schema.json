{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-definition-v1",
  "title": "ModuleDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "baseKind", "category", "label", "providerPolicy", "ports"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["draft", "published", "archived"]},
    "expectedVersion": {"type": "integer", "minimum": 1, "default": 1},
    "baseKind": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "icon": {"type": "string"},
    "providerPolicy": {
      "type": "object",
      "required": ["capability", "allowed", "locked"],
      "properties": {
        "capability": {"enum": ["text", "image", "video"]},
        "allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "default": {"type": ["string", "null"]},
        "locked": {"type": "boolean"},
        "providerConfigId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "configSchema": {"type": "object"},
    "defaultConfig": {"type": "object"},
    "ports": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}}
      },
      "additionalProperties": false
    },
    "execution": {"type": ["object", "null"]},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["id", "type", "required", "cardinality"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["text", "scene", "image", "video", "audio", "asset", "any"]},
        "required": {"type": "boolean"},
        "cardinality": {"enum": ["one", "many"]},
        "label": {"type": "string"},
        "binding": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
