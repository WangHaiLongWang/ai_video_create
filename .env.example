# ai_video_create 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ==================== Provider 配置 ====================

# 默认 LLM Provider: mock / ollama / openai / openai_compat
AI_VIDEO_DEFAULT_LLM_PROVIDER=mock

# 默认图像生成 Provider: mock / comfyui / openai
AI_VIDEO_DEFAULT_IMAGE_PROVIDER=mock

# 默认视频生成 Provider: mock / comfyui / wan3
AI_VIDEO_DEFAULT_VIDEO_PROVIDER=mock

# ==================== Ollama 配置 ====================

AI_VIDEO_OLLAMA_API_URL=http://localhost:11434
AI_VIDEO_OLLAMA_MODEL=llama3.2

# ==================== OpenAI 配置 ====================

AI_VIDEO_OPENAI_API_KEY=
AI_VIDEO_OPENAI_API_URL=https://api.openai.com/v1
AI_VIDEO_OPENAI_MODEL=gpt-4
AI_VIDEO_DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
AI_VIDEO_DASHSCOPE_API_KEY=
AI_VIDEO_DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
AI_VIDEO_DASHSCOPE_IMAGE_SIZE=1280x720
AI_VIDEO_DASHSCOPE_USE_ASYNC=false
AI_VIDEO_DASHSCOPE_PROMPT_EXTEND=true
AI_VIDEO_DASHSCOPE_PROMPT_EXTEND_MODE=direct
AI_VIDEO_DASHSCOPE_ENABLE_THINKING=true
AI_VIDEO_DASHSCOPE_WATERMARK=false
AI_VIDEO_OPENAI_IMAGE_MODEL=dall-e-3
AI_VIDEO_OPENAI_IMAGE_SIZE=1792x1024

# ==================== 自定义 OpenAI-compatible LLM ====================
# 默认预设为 Xiaomi MiMo。填写 Key 后可将 DEFAULT_LLM_PROVIDER 改为 openai_compat。

AI_VIDEO_OPENAI_COMPAT_NAME=Xiaomi MiMo
AI_VIDEO_OPENAI_COMPAT_API_URL=https://api.xiaomimimo.com/v1
AI_VIDEO_OPENAI_COMPAT_API_KEY=
AI_VIDEO_OPENAI_COMPAT_MODEL=mimo-v2.5-pro
AI_VIDEO_OPENAI_COMPAT_AUTH_HEADER=api-key
AI_VIDEO_OPENAI_COMPAT_AUTH_SCHEME=
AI_VIDEO_OPENAI_COMPAT_MAX_TOKENS_PARAM=max_completion_tokens
AI_VIDEO_OPENAI_COMPAT_MAX_TOKENS=4096
AI_VIDEO_OPENAI_COMPAT_TEMPERATURE=1.0
AI_VIDEO_OPENAI_COMPAT_TOP_P=0.95
AI_VIDEO_OPENAI_COMPAT_TIMEOUT=120

# ==================== ComfyUI 配置 ====================

AI_VIDEO_COMFYUI_API_URL=http://localhost:8188
AI_VIDEO_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# ==================== 万相 3.0 视频配置 ====================

AI_VIDEO_WAN3_API_URL=https://dashscope.aliyuncs.com/api/v1
AI_VIDEO_WAN3_API_KEY=
AI_VIDEO_WAN3_MODEL=wan3.0-video
AI_VIDEO_WAN3_RESOLUTION=480P
AI_VIDEO_WAN3_RATIO=adaptive
AI_VIDEO_WAN3_DURATION=5
AI_VIDEO_WAN3_AUDIO=true
AI_VIDEO_WAN3_SEED=-1
AI_VIDEO_WAN3_PROMPT_EXTEND=true
AI_VIDEO_WAN3_WATERMARK=false
AI_VIDEO_WAN3_POLL_INTERVAL=5
AI_VIDEO_WAN3_TIMEOUT=1800

# ==================== 存储配置 ====================

AI_VIDEO_ASSET_DIR=data/assets
AI_VIDEO_FFMPEG_PATH=ffmpeg

# ==================== Worker 配置 ====================

AI_VIDEO_WORKER_POLL_INTERVAL=0.5
AI_VIDEO_WORKER_LEASE_SECONDS=30
AI_VIDEO_WORKER_COUNT=1

# ==================== 数据库配置 ====================

AI_VIDEO_DB_PATH=data/ai_video_create.db

# ==================== 服务器配置 ====================

AI_VIDEO_HOST=127.0.0.1
AI_VIDEO_PORT=8000
AI_VIDEO_DEBUG=false
